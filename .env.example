# Supabase (Postgres) --------------------------------------------------------
# Project URL and the SERVICE ROLE key (server-side only — never expose to the client).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Per-query timeout for the reads the website does while rendering (ms).
# Default 8000. A database that HANGS rather than refuses would otherwise stall
# the server render until Vercel kills it with a 504; this caps it and falls
# back to the empty state instead.
# SUPABASE_QUERY_TIMEOUT_MS=8000


# Firecrawl (article scraping) ------------------------------------------------
# Headlines come from RSS (free). Firecrawl then fetches a SHORTLIST of articles
# per category, and the model picks the most interesting one from the real text
# — a headline alone can't tell you whether a story is a proper article or a
# two-line agency snippet. That's 6 pages x 5 categories = up to 30 credits a
# day, ~900 a month. Without this key the app still runs: each article is
# written from its RSS summary instead, which produces a shorter, thinner piece.
FIRECRAWL_API_KEY=fc-your-firecrawl-key
# HARD ceiling on scrape attempts per calendar day, counted in the database and
# shared by every run that day (the scheduled job, the "generate now" button, a
# forced local run). Default 30. A failed or paywalled page still costs one
# attempt, so it still counts. Set to 0 to turn scraping off entirely.
FIRECRAWL_DAILY_LIMIT=30
# How many articles are shortlisted and fetched per category. Default 6, which
# with five categories is exactly the daily limit above. Values below 4 leave
# the choice step with little to compare.
FIRECRAWL_SCRAPES_PER_CATEGORY=6
# How many pages are fetched at once. Default 4 — keeps a full 30-page batch
# under a minute without collecting a 429 from Firecrawl.
# FIRECRAWL_CONCURRENCY=4
# Optional. Only change these if Firecrawl moves its API.
# FIRECRAWL_API_URL=https://api.firecrawl.dev
# FIRECRAWL_API_VERSION=v2
# How long to wait for one scrape (ms). Default 25000.
# FIRECRAWL_TIMEOUT_MS=25000
# Cap on the markdown handed to the model. Default 12000 characters (~3-4k tokens).
# FIRECRAWL_MAX_CHARS=12000
# Below this many characters, treat the scrape as failed (paywall/cookie wall)
# and fall back to the feed summary. Default 400.
# FIRECRAWL_MIN_CHARS=400

# OpenAI ----------------------------------------------------------------------
OPENAI_API_KEY=sk-your-openai-key
# Optional override. Defaults to the small/cheap gpt-5.5-mini. Set to whatever
# small model your account has if that exact id isn't available (e.g. gpt-5.4) —
# `npm run check-models` prints the ids your key can actually use.
# Avoid the premium models (gpt-5.6, *-sol, *-terra) — they cost 10x+ more.
# NOTE: this file covers local runs and Vercel. The scheduled GitHub Actions run
# reads nothing from either — set it as a repository variable AND make sure it is
# mapped in .github/workflows/daily-briefing.yml's env: block (it already is).
OPENAI_MODEL=gpt-5.5-mini

# --- Cost controls (see README "Keeping costs down") -------------------------
# The expensive `web_search` tool is GONE: the model no longer browses, it reads
# the articles we scraped for it. What's left is ordinary input/output tokens.
# Ceiling on output (reasoning + article) tokens per article. Default 6144.
OPENAI_MAX_OUTPUT_TOKENS=6144
# Ceiling for the single headline-shortlist call. Default 4096 — that call ranks
# ~30 headlines rather than picking 5, so it needs more reasoning headroom.
OPENAI_SELECT_MAX_OUTPUT_TOKENS=4096
# Ceiling for the single "which of these articles is best" call. Default 3072.
# OPENAI_CHOICE_MAX_OUTPUT_TOKENS=3072
# How much of each scraped article that call is shown. Default 900 characters —
# the opening of a piece is where a news story says what happened and where a
# teaser gives itself away. This is the main input cost of the shortlist.
# OPENAI_CHOICE_EXCERPT_CHARS=900
# Cap on how many known vocab words are sent in each prompt. Default 60; 0 = all.
OPENAI_KNOWN_VOCAB_LIMIT=60
# How many "focus" words (to weave into the article) are offered per prompt.
# Default 8; 0 = send the whole (growing) bucket.
OPENAI_FOCUS_VOCAB_LIMIT=8
# Reasoning effort. 'low' (default) is plenty for this task; 'off' omits the
# parameter for models that don't accept it.
OPENAI_REASONING_EFFORT=low

# --- Quality controls --------------------------------------------------------
# Attempts per category before giving up (retries a fast failure: bad JSON, a
# truncated response, a too-short body). Default 2; 1 disables retrying.
OPENAI_MAX_ATTEMPTS=2
# How long one model call may take (ms). Default 90000.
# OPENAI_TIMEOUT_MS=90000
# Retries the OpenAI SDK itself performs on a transport error, on top of
# OPENAI_MAX_ATTEMPTS above. Default 0 — this pipeline does its own retrying,
# where it can see whether the output was actually usable.
# OPENAI_MAX_RETRIES=0
# How many words each article glosses. A tight budget is deliberate: "highlight
# generously" is what filled the glossary with filler. Defaults 8 and 12.
OPENAI_FOOTNOTES_MIN=8
OPENAI_FOOTNOTES_MAX=12

# --- Diversity ---------------------------------------------------------------
# How many days of previously-covered topics the shortlist and choice steps are
# shown, so they can refuse to pick the same subject again. Default 7; 0 disables the check
# (and with it, the main defence against every day feeling the same).
TOPIC_HISTORY_DAYS=7

# --- News feeds --------------------------------------------------------------
# Headlines are collected from 4-6 German outlets per category (see
# CATEGORY_FEEDS in lib/feeds.ts). Run `npm run check-feeds` to see which are
# currently responding. Override any category with a comma-separated feed list:
# FEEDS_POLITICS=https://www.tagesschau.de/inland/index~rss2.xml,https://newsfeed.zeit.de/politik/index
# FEEDS_FINANCE=
# FEEDS_TECHNOLOGY=
# FEEDS_GAMING=
# FEEDS_GERMANY=
# How old a headline may be, in days. Default 3.
# FEED_RECENCY_DAYS=3
# Max items kept from any one feed, so a prolific outlet can't crowd out the
# rest of the slate. Default 8.
# FEED_PER_SOURCE_LIMIT=8
# How many candidate headlines per category go to the shortlist step. Default 30.
# FEED_PER_CATEGORY_LIMIT=30
# Per-feed fetch timeout (ms). Default 10000.
# FEED_TIMEOUT_MS=10000

# --- Run pacing --------------------------------------------------------------
# Total budget for the model + scrape stages of a scheduled run (ms). Default
# 600000 (10 minutes); GitHub Actions has no function ceiling.
# BRIEFING_DEADLINE_MS=600000
# Caps for the two single-shot calls (ms). Defaults 60000 each.
# SHORTLIST_TIMEOUT_MS=60000
# CHOICE_TIMEOUT_MS=60000
# The share of the remaining budget that scraping may use, so a slow batch can't
# leave the writing stage with no time at all. Default 0.5.
# BRIEFING_SCRAPE_TIME_SHARE=0.5
# The in-app "generate now" button runs inside Vercel's 60s ceiling, so it
# shortlists fewer articles per category than the scheduled run. Default 2.
# BRIEFING_ROUTE_SCRAPES_PER_CATEGORY=2
# That button's own budget for the model + scrape stages (ms). Default 45000 —
# deliberately short of the 60s ceiling, so the DB writes still fit inside it.
# BRIEFING_ROUTE_DEADLINE_MS=45000

# Cron auth -------------------------------------------------------------------
# A random string you generate yourself. Authenticates the in-app "generate now"
# button and the cache-refresh ping from the GitHub Actions run. It now guards a
# publicly reachable endpoint on a public repo — make it 32+ random bytes.
CRON_SECRET=generate-a-long-random-string

# Where the site is deployed, e.g. https://your-app.vercel.app. Used ONLY by the
# GitHub Actions run to refresh the site's cached pages the moment the briefing
# lands, before the notification goes out (otherwise ISR catches up within five
# minutes and the article isn't there when you tap the push). Set this as a repository
# *variable* named SITE_URL, not a secret.
SITE_URL=https://your-app.vercel.app

# Web push (Phase 5) ----------------------------------------------------------
# Generate a pair once with:  npx web-push generate-vapid-keys
# The public key is handed to the browser at subscribe time, so it ships in the
# client bundle under NEXT_PUBLIC_ as well — that is by design, it is public.
# The private key signs the pushes: server-only, and it belongs in Actions
# secrets (the daily run sends the notification) as well as Vercel.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
# Required by the push spec. A mailto: or https URL a push service can use to
# reach you if your notifications misbehave. Blank makes setVapidDetails throw.
VAPID_SUBJECT=mailto:you@example.com
# Regenerating the pair invalidates every existing subscription and every device
# must be re-subscribed by hand. Generate once, store carefully.
#
# Optional, and recommended: a shared word that /api/push/subscribe requires
# before it will register a device. Those endpoints are publicly reachable on a
# public site; with this set they are closed, and the cost is typing it once per
# phone. Leave it unset and the shape checks plus the device cap are all that
# stand there — which is deliberate, but means a stranger could sign up for your
# morning news notification.
# PUSH_PASSPHRASE=
# How many devices may be registered at once. Default 50 — a cap that turns
# unbounded growth into a contained failure, not a feature you should need.
# PUSH_MAX_SUBSCRIPTIONS=50
